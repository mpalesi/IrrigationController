	cd /Users/mpalesi/dev-git/IrrigationController/firmware/build-irrigation-controller && $(CMAKE_COMMAND) -S$(CMAKE_SOURCE_DIR) -B$(CMAKE_BINARY_DIR) --check-build-system CMakeFiles/Makefile.cmake 0
